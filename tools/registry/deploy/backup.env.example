# /etc/zen-registry/backup.env on the server (chmod 600). An R2 API token with Object Read & Write on the bucket.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PROVIDER=Cloudflare
S3_BUCKET=zen-registry-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Days of nightly backups to keep.
BACKUP_KEEP_DAYS=30
