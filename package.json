{
  "name": "@zen/design-system",
  "version": "0.3.0",
  "private": true,
  "description": "Zen Design System: React components, design tokens and icons generated from the Zen Figma library. AI agents: read AGENTS.consumer.md.",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/icons/all.js",
    "./dist/components/Icon/core.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./icons/all": {
      "types": "./dist/icons/all.d.ts",
      "import": "./dist/icons/all.js",
      "default": "./dist/icons/all.js"
    },
    "./icons/names": {
      "types": "./dist/icons/names.d.ts",
      "import": "./dist/icons/names.js",
      "default": "./dist/icons/names.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./eslint": "./tools/usage-guard/eslint.mjs",
    "./usage": "./tools/usage-guard/api.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.consumer.md",
    "llms.txt",
    "docs/getting-started.md",
    "docs/guidelines",
    "docs/api",
    "src/templates",
    "tools/usage-guard/check-usage.mjs",
    "tools/usage-guard/engine.mjs",
    "tools/usage-guard/cli.mjs",
    "tools/usage-guard/eslint.mjs",
    "tools/usage-guard/api.mjs",
    "mcp/server.mjs",
    "tools/zen-ds.mjs",
    "tools/zen-audit/audit.mjs",
    "tools/zen-audit/app-checks.mjs",
    "tools/platform-audit/quality-checks.mjs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && tsc --noEmit && vite build",
    "build:lib": "npm run tokens:build && npm run styles:build && npm run icons:build && vite build --config vite.lib.config.ts && node scripts/build-lib-css.mjs && node scripts/build-lib-types.mjs && node tools/usage-guard/cli.mjs --write-context=dist/usage-context.json",
    "build:platform": "npm run tokens:build && npm run styles:build && npm run icons:build && tsc --noEmit && vite build",
    "prepack": "npm run build:lib",
    "pack:local": "mkdir -p dist-pack && npm pack --pack-destination dist-pack",
    "verify:package": "node scripts/verify-package.mjs",
    "preview": "vite preview",
    "storybook": "npm run tokens:build && npm run styles:build && npm run icons:build && storybook dev -p 6006",
    "build-storybook": "npm run tokens:build && npm run styles:build && npm run icons:build && storybook build",
    "tokens:build": "node scripts/build-tokens.mjs && node scripts/build-native-tokens.mjs",
    "tokens:check": "node scripts/check-token-coverage.mjs",
    "styles:build": "node scripts/build-text-styles.mjs && node scripts/build-style-manifest.mjs",
    "styles:check": "node scripts/check-text-styles.mjs && node scripts/check-style-manifest.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/check-icons.mjs",
    "flags:build": "node scripts/build-flags.mjs",
    "flags:check": "node scripts/build-flags.mjs --check",
    "usage:check": "node tools/usage-guard/check-usage.mjs",
    "usage:selftest": "node tools/usage-guard/selftest.mjs",
    "usage:rules": "node tools/usage-guard/check-usage.mjs --list",
    "guidelines:build": "node tools/usage-guard/build-guidelines.mjs",
    "guidelines:check": "node tools/usage-guard/build-guidelines.mjs --check",
    "platform:audit": "node tools/platform-audit/audit.mjs",
    "platform:audit:full": "node tools/platform-audit/audit.mjs --viewports=1512,1024,390 --smoke",
    "platform:shoot": "node tools/platform-audit/shoot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp:selftest": "node mcp/selftest.mjs",
    "platform:behaviour": "node tools/platform-audit/behaviour.mjs",
    "style:check": "node tools/style-guard/check-styles.mjs",
    "style:selftest": "node tools/style-guard/selftest.mjs",
    "layout:selftest": "node src/components/Layout/position.selftest.mjs && node src/components/Layout/effects.selftest.mjs",
    "studio:selftest": "node tools/studio/selftest.mjs && node tools/studio/data-source.selftest.mjs && node tools/studio/shared-code.selftest.mjs && node tools/studio/engine-iso.selftest.mjs && node tools/studio/dialect.selftest.mjs && node tools/studio/builder.selftest.mjs && node tools/studio/pages-folder.selftest.mjs && node src/platform/studio/builder/store/pageModel.selftest.mjs && node src/platform/studio/builder/library/search.selftest.mjs && node src/platform/studio/builder/library/iconSearch.selftest.mjs && node tools/studio/library-keywords-build.mjs --check && node tools/studio/figma-props-build.mjs --check && node src/platform/studio/appearance/appearanceModel.selftest.mjs && node src/platform/studio/inspector/controls/scale.selftest.mjs && node src/platform/studio/inspector/layoutModel.selftest.mjs && node src/platform/studio/select/gridTracks.selftest.mjs && node tools/studio/e2e/selftest.mjs",
    "studio:e2e": "node tools/studio/e2e/run.mjs",
    "studio:build-check": "node tools/studio/e2e/build-check.mjs",
    "qa": "node tools/qa/run.mjs",
    "qa:quick": "node tools/qa/run.mjs --quick",
    "ship": "node tools/ship/ship.mjs",
    "tokens:native": "node scripts/build-native-tokens.mjs",
    "tokens:native:check": "node scripts/build-native-tokens.mjs --check"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "magic-string": "^1.4.1",
    "playwright": "1.63.0",
    "pocketbase": "^0.26.9",
    "react": "19.3.0",
    "react-docgen": "8.0.4",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.2",
    "vitest-browser-react": "2.3.0"
  },
  "bin": {
    "zen-ds": "tools/zen-ds.mjs",
    "zen-usage": "tools/usage-guard/cli.mjs",
    "zen-ds-mcp": "mcp/server.mjs"
  }
}
